{
  "checks": [
    {
      "name": "model proposal cannot execute before human fact decisions",
      "expected_status": 409,
      "expected_code": "FACT_REVIEW_INCOMPLETE",
      "actual_status": 409,
      "actual_code": "FACT_REVIEW_INCOMPLETE",
      "passed": true
    },
    {
      "name": "idempotency key rejects a changed capture request",
      "expected_status": 409,
      "expected_code": "IDEMPOTENCY_KEY_REUSED",
      "actual_status": 409,
      "actual_code": "IDEMPOTENCY_KEY_REUSED",
      "passed": true
    },
    {
      "name": "cross-account capture access is hidden",
      "expected_status": 404,
      "expected_code": "CAPTURE_NOT_FOUND",
      "actual_status": 404,
      "actual_code": "CAPTURE_NOT_FOUND",
      "passed": true
    },
    {
      "name": "different active temporal value requires explicit supersession",
      "expected_status": 409,
      "expected_code": "STATE_CONFLICT_REQUIRES_SUPERSESSION",
      "actual_status": 409,
      "actual_code": "STATE_CONFLICT_REQUIRES_SUPERSESSION",
      "passed": true
    },
    {
      "name": "forwarded recruiter message cannot become candidate assertion",
      "expected_status": 422,
      "expected_code": "SPEAKER_ATTRIBUTION_UNSUPPORTED",
      "actual_status": 422,
      "actual_code": "SPEAKER_ATTRIBUTION_UNSUPPORTED",
      "passed": true
    },
    {
      "name": "prohibited candidate scoring is rejected",
      "expected_status": 422,
      "expected_code": "PROHIBITED_INFERENCE",
      "actual_status": 422,
      "actual_code": "PROHIBITED_INFERENCE",
      "passed": true
    },
    {
      "name": "revised action invalidates prior approval",
      "expected_status": 409,
      "expected_code": "ACTION_VERSION_CONFLICT",
      "actual_status": 409,
      "actual_code": "ACTION_VERSION_CONFLICT",
      "passed": true
    },
    {
      "name": "unknown result blocks blind retry",
      "expected_status": 409,
      "expected_code": "RECONCILIATION_REQUIRED",
      "actual_status": 409,
      "actual_code": "RECONCILIATION_REQUIRED",
      "passed": true
    },
    {
      "name": "revoked approval cannot execute",
      "expected_status": 409,
      "expected_code": "APPROVAL_NOT_CURRENT",
      "actual_status": 409,
      "actual_code": "APPROVAL_NOT_CURRENT",
      "passed": true
    },
    {
      "name": "deleted capture retrieval is revoked",
      "expected_status": 410,
      "expected_code": "CAPTURE_DELETED",
      "actual_status": 410,
      "actual_code": "CAPTURE_DELETED",
      "passed": true
    },
    {
      "name": "deleted source action cannot execute",
      "expected_status": 410,
      "expected_code": "ACTION_DELETED",
      "actual_status": 410,
      "actual_code": "ACTION_DELETED",
      "passed": true
    },
    {
      "name": "cross-account deletion lineage is hidden",
      "expected_status": 404,
      "expected_code": "DELETION_NOT_FOUND",
      "actual_status": 404,
      "actual_code": "DELETION_NOT_FOUND",
      "passed": true
    },
    {
      "name": "revoked capability blocks a current exact approval",
      "expected_status": 403,
      "expected_code": "CAPABILITY_NOT_AUTHORIZED",
      "actual_status": 403,
      "actual_code": "CAPABILITY_NOT_AUTHORIZED",
      "passed": true
    }
  ]
}
