{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talent-signal.local/evals/v2/schemas/rubric.schema.json",
  "title": "EvaluationRubricV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rubricId", "version", "contentDigest", "purpose", "evaluatorType", "gateAuthority", "criteria"],
  "properties": {
    "schemaVersion": { "const": "evaluation-rubric.v1" },
    "rubricId": { "type": "string" },
    "version": { "type": "string" },
    "contentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "purpose": { "type": "string", "minLength": 8 },
    "evaluatorType": { "enum": ["deterministic", "human", "model", "outcome"] },
    "gateAuthority": { "enum": ["p0_gate", "quality_gate", "informational", "none"] },
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterionId", "description", "evidenceRequired", "passCondition", "failureDisposition"],
        "properties": {
          "criterionId": { "type": "string" },
          "description": { "type": "string" },
          "evidenceRequired": { "type": "string" },
          "passCondition": { "type": "string" },
          "failureDisposition": { "enum": ["fail", "needs_review", "informational"] }
        }
      }
    },
    "calibrationPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["minimumCaseCriterionDecisions", "p0Authority", "requiredMeasures"],
      "properties": {
        "minimumCaseCriterionDecisions": { "type": "integer", "minimum": 0 },
        "p0Authority": { "const": false },
        "requiredMeasures": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
