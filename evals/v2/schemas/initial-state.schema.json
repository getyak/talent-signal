{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talent-signal.local/evals/v2/schemas/initial-state.schema.json",
  "title": "EvaluationInitialStateFixtureV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "scenarioId", "state"],
  "properties": {
    "schemaVersion": { "const": "evaluation-initial-state.v1" },
    "fixtureId": { "type": "string", "pattern": "^initial-state:TS-[A-Z]+-[0-9]+:r[0-9]+$" },
    "scenarioId": { "type": "string" },
    "state": { "type": "object" }
  }
}
