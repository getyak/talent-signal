{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talent-signal.local/evals/v2/schemas/p0-journey-mapping.schema.json",
  "title": "P0JourneyMappingV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mappingId", "contentDigest", "sourceContract", "journeys"],
  "properties": {
    "schemaVersion": { "const": "evaluation-p0-journey-mapping.v1" },
    "mappingId": { "type": "string" },
    "contentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceContract": { "type": "string" },
    "journeys": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["journeyId", "title", "scenarioIds", "canonicalOracle", "releaseBlockers"],
        "properties": {
          "journeyId": { "type": "string", "pattern": "^V1-P0-[0-9]{2}$" },
          "title": { "type": "string" },
          "scenarioIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "canonicalOracle": { "type": "string" },
          "releaseBlockers": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
