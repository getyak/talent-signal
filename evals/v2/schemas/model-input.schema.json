{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talent-signal.local/evals/v2/schemas/model-input.schema.json",
  "title": "EvaluationModelInputFixtureV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "dataClass", "scenarioId", "input"],
  "properties": {
    "schemaVersion": { "const": "evaluation-model-input.v1" },
    "fixtureId": { "type": "string", "pattern": "^model-input:TS-[A-Z]+-[0-9]+:r[0-9]+$" },
    "dataClass": { "enum": ["synthetic_shareable", "synthetic_restricted"] },
    "scenarioId": { "type": "string" },
    "input": {
      "type": "object",
      "required": ["task", "source"],
      "properties": {
        "task": { "type": "string", "minLength": 6 },
        "source": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
