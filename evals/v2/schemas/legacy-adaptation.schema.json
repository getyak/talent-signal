{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talent-signal.local/evals/v2/schemas/legacy-adaptation.schema.json",
  "title": "LegacyAdaptationMapV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mappingId", "contentDigest", "sourceSuite", "sourceVersion", "targetSuite", "adaptations"],
  "properties": {
    "schemaVersion": { "const": "evaluation-legacy-adaptation.v1" },
    "mappingId": { "type": "string" },
    "contentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceSuite": { "type": "string" },
    "sourceVersion": { "type": "string" },
    "targetSuite": { "type": "string" },
    "adaptations": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["legacyCaseId", "anchorScenarioIds", "preservedSemantics", "adapterRule", "lossless"],
        "properties": {
          "legacyCaseId": { "type": "string" },
          "anchorScenarioIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "preservedSemantics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "adapterRule": { "type": "string" },
          "lossless": { "const": true }
        }
      }
    }
  }
}
