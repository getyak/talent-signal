{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talent-signal.local/evals/v2/schemas/scenario.schema.json",
  "title": "EvaluationScenarioDocumentV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioId",
    "revision",
    "contentDigest",
    "title",
    "purpose",
    "suiteIds",
    "riskTier",
    "lifecycle",
    "adjudication",
    "partition",
    "compatibleProfileIds",
    "criterionAdjudications",
    "dataPolicy",
    "modelInputRef",
    "initialStateRef",
    "oracleRef",
    "evaluatorBindings",
    "slices",
    "lineage"
  ],
  "properties": {
    "schemaVersion": { "const": "evaluation-scenario.v1" },
    "scenarioId": { "type": "string", "pattern": "^TS-(CAP|ID|MEM|TRJ|ACT)-[0-9]{3}$" },
    "revision": { "type": "string", "pattern": "^[0-9]+$" },
    "contentDigest": { "$ref": "#/$defs/digest" },
    "title": { "type": "string", "minLength": 4 },
    "purpose": { "type": "string", "minLength": 12 },
    "suiteIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "riskTier": { "enum": ["p0_blocker", "p1_core", "p2_quality"] },
    "lifecycle": { "enum": ["draft", "active", "retired"] },
    "adjudication": { "enum": ["unreviewed", "human_gold", "disputed"] },
    "partition": { "enum": ["p0", "dev", "held_out", "red_team"] },
    "compatibleProfileIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "criterionAdjudications": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "status", "evidence"],
        "properties": {
          "criterionId": { "type": "string", "minLength": 3 },
          "status": { "enum": ["unreviewed", "human_gold", "disputed"] },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidenceLocator" }
          },
          "reviewerId": { "type": "string", "minLength": 3 },
          "decisionId": { "type": "string", "minLength": 3 },
          "decidedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "dataPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataClass", "containsRealCandidateData", "projection"],
      "properties": {
        "dataClass": { "enum": ["synthetic_shareable", "synthetic_restricted", "deidentified_governed", "private_reference_only", "prohibited_export"] },
        "containsRealCandidateData": { "type": "boolean" },
        "projection": { "enum": ["synthetic_content_opt_in", "metadata_only", "prohibited"] }
      }
    },
    "modelInputRef": { "$ref": "#/$defs/ref" },
    "initialStateRef": { "$ref": "#/$defs/ref" },
    "oracleRef": { "$ref": "#/$defs/ref" },
    "evaluatorBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evaluatorId", "version", "contentDigest", "kind", "criterionIds", "requiredForGate"],
        "properties": {
          "evaluatorId": { "type": "string", "minLength": 3 },
          "version": { "type": "string", "minLength": 1 },
          "contentDigest": { "$ref": "#/$defs/digest" },
          "kind": { "enum": ["deterministic", "human", "model", "outcome"] },
          "criterionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "requiredForGate": { "type": "boolean" }
        }
      }
    },
    "slices": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": { "type": "string" }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKind", "sourceIds"],
      "properties": {
        "sourceKind": { "enum": ["native", "legacy_adapter", "governed_case_proposal"] },
        "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "previousRevision": { "type": "string" },
        "previousDigest": { "$ref": "#/$defs/digest" },
        "authorizationRef": { "type": "string", "minLength": 3 }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidenceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "jsonPointer": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "path", "contentDigest"],
      "properties": {
        "fixtureId": { "type": "string", "minLength": 4 },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "contentDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
