{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talent-signal.local/evals/v2/schemas/oracle.schema.json",
  "title": "EvaluationOracleFixtureV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "oracleId",
    "scenarioId",
    "observations",
    "identity",
    "transitions",
    "terminal",
    "requiredQuestions",
    "allowedEffects",
    "forbidden"
  ],
  "properties": {
    "schemaVersion": { "const": "evaluation-oracle.v1" },
    "oracleId": { "type": "string", "pattern": "^oracle:TS-[A-Z]+-[0-9]+:r[0-9]+$" },
    "scenarioId": { "type": "string" },
    "observations": { "type": "array", "items": { "$ref": "#/$defs/criterion" } },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "decision", "reviewRequired"],
      "properties": {
        "criterionId": { "type": "string" },
        "decision": { "enum": ["not_applicable", "propose_new", "require_human_binding", "abstain", "propose_merge", "possible_matches"] },
        "expectedPersonRef": { "type": "string" },
        "reviewRequired": { "type": "boolean" },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "status", "reasonCode"],
      "properties": {
        "criterionId": { "type": "string" },
        "status": { "enum": ["no_action", "clarify", "abstain", "proposal", "blocked", "partial", "completed"] },
        "reasonCode": { "type": "string", "minLength": 3 }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "kind", "maxCount", "requiresHumanReview"],
      "properties": {
        "criterionId": { "type": "string" },
        "kind": { "type": "string" },
        "maxCount": { "type": "integer", "minimum": 0 },
        "requiresHumanReview": { "type": "boolean" },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "requiredQuestions": { "type": "array", "items": { "type": "string" } },
    "allowedEffects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effectType", "maxCount", "requiresExactApproval"],
        "properties": {
          "effectType": { "type": "string" },
          "maxCount": { "type": "integer", "minimum": 0 },
          "requiresExactApproval": { "type": "boolean" }
        }
      }
    },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "code", "description", "blocker"],
        "properties": {
          "criterionId": { "type": "string" },
          "code": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "description": { "type": "string", "minLength": 6 },
          "blocker": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "operator", "actualPath", "expected"],
      "properties": {
        "criterionId": { "type": "string" },
        "operator": { "enum": ["equals", "contains", "excludes", "exists", "count_equals", "at_most", "ordered_before"] },
        "actualPath": { "type": "string" },
        "expected": {}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "operation", "target", "authority", "evidenceRefs"],
      "properties": {
        "criterionId": { "type": "string" },
        "operation": { "type": "string" },
        "target": { "type": "string" },
        "authority": { "enum": ["none", "proposed", "confirmed", "contested", "unavailable", "external_observed"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
