{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talent-signal.local/evals/v2/schemas/suite.schema.json",
  "title": "EvaluationSuiteV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suiteId", "version", "contentDigest", "title", "purpose", "scenarios", "lineage"],
  "properties": {
    "schemaVersion": { "const": "evaluation-suite.v1" },
    "suiteId": { "type": "string" },
    "version": { "type": "string" },
    "contentDigest": { "$ref": "#/$defs/digest" },
    "title": { "type": "string" },
    "purpose": { "type": "string" },
    "scenarios": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scenarioId", "revision", "contentDigest", "lifecycle", "adjudication", "criterionAdjudicationDigest", "partition", "dataClass"],
        "properties": {
          "scenarioId": { "type": "string" }, "revision": { "type": "string" }, "contentDigest": { "$ref": "#/$defs/digest" },
          "lifecycle": { "enum": ["draft", "active", "retired"] }, "adjudication": { "enum": ["unreviewed", "human_gold", "disputed"] },
          "criterionAdjudicationDigest": { "$ref": "#/$defs/digest" },
          "partition": { "enum": ["p0", "dev", "held_out", "red_team"] },
          "dataClass": { "enum": ["synthetic_shareable", "synthetic_restricted", "deidentified_governed", "private_reference_only", "prohibited_export"] }
        }
      }
    },
    "lineage": {
      "type": "object", "additionalProperties": false, "required": ["sourceKind", "sourceIds"],
      "properties": {
        "sourceKind": { "enum": ["native", "legacy_adapter", "governed_case_proposal"] },
        "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "previousRevision": { "type": "string" }, "previousDigest": { "$ref": "#/$defs/digest" }, "authorizationRef": { "type": "string" }
      }
    }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
