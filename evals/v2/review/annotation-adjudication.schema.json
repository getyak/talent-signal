{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talent-signal.local/evaluation/annotation-adjudication.v1.schema.json",
  "title": "Talent Signal annotation adjudication decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionId", "scenarioId", "attemptId", "criterionId", "proposalIds", "adjudicatorRef", "outcome", "evidenceLocators", "rationale", "decidedAt"],
  "properties": {
    "decisionId": { "type": "string", "minLength": 1 },
    "scenarioId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "criterionId": { "type": "string", "minLength": 1 },
    "proposalIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "adjudicatorRef": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["confirmed", "disputed", "rejected"] },
    "selectedLabel": { "enum": ["accept", "accept_with_edits", "reject", "wrong_person", "wrong_speaker", "missing_evidence", "stale", "unnecessary_research", "unsafe_action"] },
    "evidenceLocators": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "decidedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "confirmed" } }, "required": ["outcome"] },
      "then": { "required": ["selectedLabel"] },
      "else": { "not": { "required": ["selectedLabel"] } }
    }
  ]
}
