{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talentsignal.ai/evals/overnight-run-manifest.schema.json",
  "title": "Talent Signal overnight review-object run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "review_object_id",
    "base_commit",
    "result_commit",
    "environment",
    "fixture",
    "data_classification",
    "core_case_results",
    "command_results",
    "artifacts",
    "assertion_results",
    "untested_behavior"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "review_object_id": {
      "enum": [
        "codex_plugin",
        "chrome_browser_extension",
        "web",
        "ios",
        "backend_control_plane",
        "integrated_localhost_journey"
      ]
    },
    "base_commit": {
      "const": "f66581cbf8a1b1154156fc25231a6ff82f11c61f"
    },
    "result_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "runtime",
        "localhost_endpoints"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "localhost_endpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://(127\\.0\\.0\\.1|localhost)(:[0-9]+)?(/.*)?$"
          },
          "uniqueItems": true
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "suite_id",
        "version",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "evals/candidate-momentum-v1.json"
        },
        "suite_id": {
          "const": "talent-signal-candidate-momentum-v1"
        },
        "version": {
          "const": "2026-08-05.1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "data_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "contains_live_candidate_data",
        "live_external_writes"
      ],
      "properties": {
        "mode": {
          "const": "synthetic_fixture_only"
        },
        "contains_live_candidate_data": {
          "const": false
        },
        "live_external_writes": {
          "const": false
        }
      }
    },
    "core_case_results": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "status",
          "observed_disposition",
          "evidence_locators",
          "exact_gap"
        ],
        "properties": {
          "case_id": {
            "enum": [
              "TS-CORE-01",
              "TS-CORE-02",
              "TS-CORE-03",
              "TS-CORE-04",
              "TS-ID-01",
              "TS-ID-03",
              "TS-ACT-01",
              "TS-BOUND-01"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "observed_disposition": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_locators": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exact_gap": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "command_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "command",
          "status",
          "exit_code",
          "output_locator"
        ],
        "properties": {
          "command_id": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "output_locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "locator",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "assertion_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assertion_id",
          "status",
          "evidence_locators",
          "exact_gap"
        ],
        "properties": {
          "assertion_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "evidence_locators": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exact_gap": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "untested_behavior": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
