{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talentsignal.ai/evals/web-browser-craft-review.schema.json",
  "title": "Talent Signal Web and browser craft review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "rubric_id",
    "artifact",
    "dimension_results",
    "integrated_journey",
    "vetoes",
    "findings",
    "verdict"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "rubric_id": {
      "const": "talent-signal-web-browser-craft-v1"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "review_objects",
        "example_only"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "review_objects": {
          "type": "array",
          "items": {
            "enum": [
              "chrome_browser_extension",
              "web",
              "integrated_localhost_journey"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "example_only": {
          "type": "boolean"
        }
      }
    },
    "dimension_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension_id",
          "in_scope",
          "score",
          "evidence_level",
          "evidence_locators",
          "exact_gap",
          "not_applicable_reason"
        ],
        "properties": {
          "dimension_id": {
            "type": "string",
            "minLength": 1
          },
          "in_scope": {
            "type": "boolean"
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "evidence_level": {
            "enum": [
              "direct",
              "supported_inference",
              "insufficient",
              "not_applicable"
            ]
          },
          "evidence_locators": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exact_gap": {
            "type": [
              "string",
              "null"
            ]
          },
          "not_applicable_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "integrated_journey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "score",
        "evidence_level",
        "evidence_locators",
        "exact_gap"
      ],
      "properties": {
        "in_scope": {
          "type": "boolean"
        },
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "evidence_level": {
          "enum": [
            "direct",
            "supported_inference",
            "insufficient",
            "not_applicable"
          ]
        },
        "evidence_locators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exact_gap": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "vetoes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "gap",
          "evidence",
          "owner",
          "pass_condition"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "gap": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "pass_condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "pass",
        "needs_correction",
        "fail",
        "abstain"
      ]
    }
  }
}
