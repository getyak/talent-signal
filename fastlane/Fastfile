ENV["FASTLANE_SKIP_UPDATE_CHECK"] ||= "1"

default_platform(:ios)

APP_IDENTIFIER = "com.talentsignal.app"
SHARE_EXTENSION_IDENTIFIER = "com.talentsignal.app.share"
LIVE_ACTIVITY_IDENTIFIER = "com.talentsignal.app.live-activity"
APP_IDENTIFIERS = [
  APP_IDENTIFIER,
  SHARE_EXTENSION_IDENTIFIER,
  LIVE_ACTIVITY_IDENTIFIER
].freeze
REPOSITORY_ROOT = File.expand_path("..", __dir__)
IOS_PROJECT = File.join(REPOSITORY_ROOT, "apps/ios/TalentSignal.xcodeproj")
IOS_SCHEME = "TalentSignal"
IOS_OUTPUT = File.join(REPOSITORY_ROOT, "build/ios")
IOS_ENVIRONMENT_SCRIPT = File.join(
  REPOSITORY_ROOT,
  "scripts/ios/configure-build-environment.mjs"
)
DEFAULT_MATCH_GIT_URL = "git@github.com:getyak/talent-signal-certs.git"
DEFAULT_MATCH_GIT_BRANCH = "main"

def configure_ios_environment(configuration)
  sh(
    "node",
    IOS_ENVIRONMENT_SCRIPT,
    "--configuration", configuration
  )
end

def app_store_connect_key
  key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]

  if key_path && File.exist?(key_path)
    key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: key_path,
      in_house: false
    )

    # match treats this standard environment variable as a second api_key_path
    # option. The lane already passes the authenticated key object explicitly.
    ENV.delete("APP_STORE_CONNECT_API_KEY_PATH")
    return key
  end

  key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
  UI.user_error!("Set APP_STORE_CONNECT_API_KEY_PATH or APP_STORE_CONNECT_API_KEY_CONTENT") unless key_content

  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: key_content,
    in_house: false
  )
end

def archive_testflight_build(key)
  team_id = ENV.fetch("DEVELOPMENT_TEAM", "6RG2F8YY59")
  release_version = ENV.fetch("RELEASE_VERSION", "0.1.0")
  build_number = ENV["BUILD_NUMBER"] || Time.now.utc.strftime("%Y%m%d%H%M")

  match(
    type: "appstore",
    app_identifier: APP_IDENTIFIERS,
    api_key: key,
    git_url: ENV["MATCH_GIT_URL"] || DEFAULT_MATCH_GIT_URL,
    git_branch: ENV["MATCH_GIT_BRANCH"] || DEFAULT_MATCH_GIT_BRANCH,
    readonly: true
  )

  increment_version_number(
    version_number: release_version,
    xcodeproj: IOS_PROJECT
  )
  increment_build_number(
    build_number: build_number,
    xcodeproj: IOS_PROJECT
  )

  build_app(
    project: IOS_PROJECT,
    scheme: IOS_SCHEME,
    configuration: "Release",
    clean: true,
    export_method: "app-store",
    output_directory: IOS_OUTPUT,
    output_name: "TalentSignal.ipa",
    export_options: {
      method: "app-store",
      signingStyle: "manual",
      teamID: team_id,
      provisioningProfiles: {
        APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}",
        SHARE_EXTENSION_IDENTIFIER => "match AppStore #{SHARE_EXTENSION_IDENTIFIER}",
        LIVE_ACTIVITY_IDENTIFIER => "match AppStore #{LIVE_ACTIVITY_IDENTIFIER}"
      }
    }
  )
end

def upload_testflight_build(key)
  ipa_path = File.join(IOS_OUTPUT, "TalentSignal.ipa")
  UI.user_error!("Archive the TestFlight IPA before uploading") unless File.file?(ipa_path)

  upload_to_testflight(
    api_key: key,
    app_identifier: APP_IDENTIFIER,
    ipa: ipa_path,
    distribute_external: false,
    skip_waiting_for_build_processing: true,
    uses_non_exempt_encryption: false
  )
end

platform :ios do
  desc "Compile the Release configuration without code signing"
  lane :build_only do
    configure_ios_environment("Release")
    sh(
      "xcodebuild",
      "-project", IOS_PROJECT,
      "-scheme", IOS_SCHEME,
      "-configuration", "Release",
      "-destination", "generic/platform=iOS",
      "CODE_SIGNING_ALLOWED=NO",
      "clean", "build"
    )
  end

  desc "Create or refresh App Store profiles for the app and extensions"
  lane :prepare_signing do
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIERS,
      api_key: app_store_connect_key,
      git_url: ENV["MATCH_GIT_URL"] || DEFAULT_MATCH_GIT_URL,
      git_branch: ENV["MATCH_GIT_BRANCH"] || DEFAULT_MATCH_GIT_BRANCH,
      force: true,
      readonly: false
    )
  end

  desc "Archive an internal TestFlight build without uploading it"
  lane :archive_beta do
    setup_ci if ENV["CI"]
    configure_ios_environment("Release")
    archive_testflight_build(app_store_connect_key)
    UI.success("Talent Signal IPA archived for TestFlight")
  end

  desc "Upload the previously archived internal TestFlight build without polling"
  lane :upload_beta do
    setup_ci if ENV["CI"]
    upload_testflight_build(app_store_connect_key)
    UI.success("Talent Signal upload accepted by App Store Connect")
  end

  desc "Archive and upload an internal TestFlight build without polling"
  lane :beta do
    setup_ci if ENV["CI"]
    configure_ios_environment("Release")
    key = app_store_connect_key
    archive_testflight_build(key)
    upload_testflight_build(key)
    UI.success("Talent Signal upload accepted by App Store Connect")
  end
end
