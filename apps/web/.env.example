NEXT_PUBLIC_SITE_URL=https://gettalentsignal.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Generate with: pnpm --filter @talent-signal/web auth:hash-password "your password"
AUTH_SECRET=
AUTH_TRUST_HOST=false
AUTH_DEFAULT_ACCOUNT_ENABLED=false
AUTH_DEFAULT_ACCOUNT_NAME=
AUTH_DEFAULT_ACCOUNT_EMAIL=
AUTH_DEFAULT_ACCOUNT_PASSWORD_SCRYPT=
AUTH_DEFAULT_ACCOUNT_QUICK_LOGIN=false

# Optional shared local development backend. Only localhost, 127.0.0.1, and
# ::1 are accepted. The endpoint must return the frozen eight-case contract
# from /v1/candidate-momentum/cases with data_mode set to fixture or
# synchronized. Invalid or unavailable responses fall back to labeled fixtures.
TALENT_SIGNAL_BACKEND_URL=

# Google callback: https://your-domain/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Local-only alternative: path to a downloaded Google OAuth client JSON file.
AUTH_GOOGLE_CREDENTIALS_FILE=

# Apple callback: https://your-domain/api/auth/callback/apple
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Optional private AI evidence review. Server-side only; never prefix secrets
# with NEXT_PUBLIC_. Production remains disabled unless the public demo gate is
# deliberately enabled or replaced with authenticated access.
TALENT_SIGNAL_AI_ENABLED=false
TALENT_SIGNAL_ALLOW_PUBLIC_AI_DEMO=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ordered capability tiers. OpenRouter may fall through in this order while
# still requiring structured output and zero-data-retention-compatible routes.
TALENT_SIGNAL_LLM_MODEL_GENERAL=deepseek/deepseek-v4-pro
TALENT_SIGNAL_LLM_MODEL_HEAVY=anthropic/claude-opus-5
TALENT_SIGNAL_LLM_MODEL_FAST=deepseek/deepseek-v4-flash-0731

# Authenticated multimodal screenshot fallback when Ark is not configured.
# The same sensitive-processing gate below still applies.
TALENT_SIGNAL_OPENROUTER_SCREENSHOT_MODEL=google/gemini-3.1-flash-lite
# Optional comma-separated provider slugs, for example google-vertex.
TALENT_SIGNAL_OPENROUTER_PROVIDER_ORDER=

# Volcano Ark screenshot understanding and generic image generation.
# Keep all credentials server-side. Candidate screenshots use the multimodal
# understanding model. They are never routed to Seedream image generation.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_PROJECT_NAME=default
ARK_API_KEY_NAME=
ARK_API_KEY_RESOURCE_ID=
ARK_API_KEY=
TALENT_SIGNAL_ALLOW_SENSITIVE_AI_PROCESSING=false
TALENT_SIGNAL_SCREENSHOT_MODEL=doubao-seed-2-0-lite-260215
TALENT_SIGNAL_IMAGE_MODEL=doubao-seedream-5-0-lite-260128

# Optional dedicated HMAC secret for short-lived screenshot analysis receipts.
# AUTH_SECRET is used when this is omitted.
TALENT_SIGNAL_ANALYSIS_RECEIPT_SECRET=

# Reserved for the later voice-capture input. Not used by the Web screenshot
# slice and never exposed to the browser.
VOICE_ASR_PROVIDER=doubao
DOUBAO_ASR_APP_ID=
DOUBAO_ASR_ACCESS_TOKEN=
DOUBAO_ASR_SECRET_KEY=
