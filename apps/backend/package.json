{
  "name": "@talent-signal/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "pnpm --filter @talent-signal/contracts build && pnpm --filter @talent-signal/agent build && tsc6 -p tsconfig.json",
    "typecheck": "pnpm --filter @talent-signal/contracts build && pnpm --filter @talent-signal/agent build && tsc6 -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:built": "node dist/database/migrate.js",
    "seed": "tsx src/database/seed.ts",
    "seed:built": "node dist/database/seed.js",
    "test": "vitest run",
    "test:integration": "tsx src/evaluation/runEvaluation.ts",
    "test:pursuits": "tsx src/evaluation/runPursuitDomainEvaluation.ts",
    "test:pursuit-proposals": "tsx src/evaluation/runPursuitProposalEvaluation.ts",
    "test:pursuit-workspace": "tsx src/evaluation/runPursuitWorkspaceEvaluation.ts",
    "test:pursuit-evidence": "tsx src/evaluation/runPursuitEvidenceIntegrityEvaluation.ts",
    "test:evidence-review-authority": "tsx src/evaluation/runEvidenceReviewAuthorityEvaluation.ts",
    "test:agent-control-plane": "tsx src/evaluation/runAgentControlPlaneEvaluation.ts",
    "fixture:ios-pursuit-proposal": "tsx src/evaluation/prepareIOSPursuitProposalFixture.ts",
    "fixture:ios-pursuit-proposal-server": "tsx src/evaluation/startIOSPursuitProposalFixtureServer.ts",
    "fixture:response-loss-proxy": "tsx src/evaluation/startResponseLossProxy.ts",
    "fixture:text-signal-proxy": "tsx src/evaluation/startTextSignalCaptureProxy.ts",
    "test:retention": "tsx src/evaluation/runRetentionEvaluation.ts",
    "test:integration:built": "node dist/evaluation/runEvaluation.js",
    "test:pursuits:built": "node dist/evaluation/runPursuitDomainEvaluation.js",
    "test:pursuit-proposals:built": "node dist/evaluation/runPursuitProposalEvaluation.js",
    "test:pursuit-evidence:built": "node dist/evaluation/runPursuitEvidenceIntegrityEvaluation.js",
    "test:agent-control-plane:built": "node dist/evaluation/runAgentControlPlaneEvaluation.js",
    "ci": "./scripts/ci.sh",
    "check:local": "./scripts/local-check.sh"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.5.2",
    "@sinclair/typebox": "^0.34.41",
    "@talent-signal/agent": "workspace:*",
    "@talent-signal/contracts": "workspace:*",
    "fastify": "^5.12.1",
    "jose": "6.2.10",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.11"
  }
}
