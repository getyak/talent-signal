# Local Agent model provider. Keep these values on the Agent host.
TALENT_SIGNAL_AGENT_PROVIDER=claude
TALENT_SIGNAL_AGENT_MODEL=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# ZHIPU_API_KEY=

# Local public-web search provider. Exactly one provider is selected per run.
TALENT_SIGNAL_AGENT_WEB_SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=

# Optional local state root. Defaults to ~/.talent-signal/agent.
# TALENT_SIGNAL_AGENT_STATE_DIR=
