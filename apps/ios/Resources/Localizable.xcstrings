      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在生成可编辑的转写…" } } }
    },
    "Keep Talent Signal in the foreground to use voice input." : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用语音输入时，请让 Talent Signal 保持在前台。" } } }
    },
