          }
        }
      }
    },
    "Try another person or context.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请尝试其他人物或情境。"
          }
        }
      }
    },
    "Try Calendar sync again": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试日历同步"
          }
        }
      }
    },
    "Try It With My Signal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用我的 Signal 试试看"
          }
        }
      }
    },
    "Turn meetings and conversations into evidence-backed next steps.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把会议与对话变成有证据支持的下一步。"
          }
        }
      }
    },
    "Turn one conversation into a next move you can trust.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把一次对话变成可信的下一步。"
          }
        }
      }
    },
    "Turning sync off keeps new confirmed events in Talent Signal without changing Apple Calendar.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭同步后，新确认的日程会保留在 Talent Signal，不会更改 Apple 日历。"
          }
        }
      }
    },
    "Type or paste": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
