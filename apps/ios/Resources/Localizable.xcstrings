          }
        }
      }
    },
    "Update delayed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新有所延迟"
          }
        }
      }
    },
    "Updated %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已更新 %@"
          }
        }
      }
    },
    "Upload complete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传完成"
          }
        }
      }
    },
    "Upload failed. Retry keeps the same image identity.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传失败。重试会继续使用同一图片标识。"
          }
        }
      }
    },
    "Uploading image": {
      "localizations": {
