    "Close Agent": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "关闭 Agent" } } } },
    "Contact, calendar, message, and CRM writes ask first": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "联系人、日历、消息与 CRM 写入都会先询问" } } } },
    "Contacts, vCard & CSV": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "联系人、vCard 与 CSV" } } } },
