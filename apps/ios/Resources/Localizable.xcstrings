          "stringUnit": {
            "state": "translated",
            "value": "正在上传图片"
          }
        }
      }
    },
    "Use a Demo Meeting": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用演示会议"
          }
        }
      }
    },
    "Use Doubao voice transcription?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用豆包语音转写？"
          }
        }
      }
    },
    "Use English for Talent Signal controls and guidance.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Talent Signal 的控件与引导使用英文。"
          }
        }
      }
    },
    "Use habit and preference patterns": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用习惯与偏好模式"
          }
        }
      }
    },
    "Use my own Signal": {
      "localizations": {
