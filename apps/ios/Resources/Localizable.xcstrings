    "Process On Device" : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在设备端处理" } } }
    },
    "Review Without AI" : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不使用 AI 审阅" } } }
    },
    "The Source and Draft are already saved locally. Either route creates a Proposal, not a fact; the manual route copies your exact Signal without model interpretation." : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "来源和草稿已在本地保存。任一路径都只会创建 Proposal，不会直接成为事实；手动路径会原样复制你的 Signal，不进行模型解读。" } } }
    },
    "This removes the retained Share or Shortcut item and the local Draft, Proposal, and verified progress derived from it. It does not delete the original item from the source app." : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这会删除保留的分享或快捷指令项目，以及由其派生的本地草稿、Proposal 和已验证进展。不会删除来源 App 中的原始项目。" } } }
    },
    "Allow Calendar Access" : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "允许访问日历" } } }
    },
