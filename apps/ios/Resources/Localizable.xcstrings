      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在聆听" } } }
    },
    "Microphone permission was not granted. No audio was recorded." : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未获得麦克风权限，因此没有录制任何音频。" } } }
    },
    "Nothing is sent to the Agent until you tap Send." : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "点击发送前，任何内容都不会交给 Agent。" } } }
    },
    "Records your voice in the foreground. The transcript remains editable before Send." : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在前台录下你的口述；发送前，转写文字始终可以编辑。" } } }
    },
