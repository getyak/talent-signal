    "No events have been read. Select only the calendar needed for this Pursuit, or continue with a Demo Meeting, Voice, or Text." : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "尚未读取任何日程。仅选择此 Pursuit 所需的日历，或使用演示会议、语音或文本继续。" } } }
