      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，未读"
          }
        }
      }
    },
    "%@ · +%lld more": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 另有 %lld 个情境"
          }
        }
      }
    },
    "%@ sits behind every screenshot, note, and conversation. It can find people, extract timing, stage contact or calendar work, and keep memory alive across sessions without taking action on its own.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 位于每一张截图、每一条笔记和每一次对话背后。它可以识别人、提取时间、整理联系人或日历工作，并在不同会话之间保持记忆延续，但不会自行采取外部行动。"
          }
        }
      }
    },
    "%@, %@, %@, %@%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
