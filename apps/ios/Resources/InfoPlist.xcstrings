{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCalendarsFullAccessUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Talent Signal reads a bounded recent and upcoming window so you can choose a meeting. It does not change events during onboarding." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Talent Signal 只读取有限的近期与即将发生的日程，供你选择会议；引导期间不会更改任何日程。" } }
      }
    },
    "NSCalendarsUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Talent Signal reads event titles and times only after you choose Calendar, so you can select the right meeting." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只有在你选择日历后，Talent Signal 才会读取日程标题与时间，供你选择正确的会议。" } }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Talent Signal uses Apple's Calendar editor only after you review the exact event title and time." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Talent Signal 只会在你审阅确切的日程标题和时间后，使用 Apple 日历编辑器。" } }
      }
    },
    "NSContactsUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Talent Signal opens Apple's contact editor only after you review the exact fields you want to add." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Talent Signal 只会在你审阅要添加的确切字段后，打开 Apple 通讯录编辑器。" } }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Talent Signal records audio only after you confirm authorization and tap Start while the app is in the foreground." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只有在你确认授权并于应用前台点按开始后，Talent Signal 才会录制音频。" } }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Talent Signal imports only the conversation image you choose." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Talent Signal 只会导入你主动选择的对话图片。" } }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Talent Signal transcribes only the foreground recording you explicitly start, using on-device speech when available." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Talent Signal 只转写你明确在前台启动的录音，并在可用时使用设备端语音识别。" } }
      }
    }
  },
  "version" : "1.0"
}
