# Local synthetic development only. Do not reuse these values outside localhost.
POSTGRES_DB=talent_signal_local
POSTGRES_USER=talent_signal_local
POSTGRES_PASSWORD=talent_signal_local_only
TALENT_SIGNAL_RESEARCH_ALLOW_SYNTHETIC_DNS_GATEWAY=false

# Bounded Agent provider. Deterministic is the safe default. Claude remains
# server-only, requires one explicitly pinned model, and is hard-limited to
# synthetic source evidence until the provider is admitted for private data.
TALENT_SIGNAL_AGENT_PROVIDER=deterministic
TALENT_SIGNAL_AGENT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Blank auto-enables the SDK task-budget field only for api.anthropic.com.
# Set true only when a compatible proxy supports output_config.task_budget.
TALENT_SIGNAL_CLAUDE_TASK_BUDGET_ENABLED=
POSTGRES_PORT=55432
BACKEND_PORT=4317
TALENT_SIGNAL_API_BASE_URL=http://127.0.0.1:4317
SESSION_TTL_SECONDS=28800
SIMULATED_AUTH_ENABLED=true
APPLE_SIGN_IN_ENABLED=false
APPLE_SIGN_IN_AUDIENCES=com.talentsignal.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info
