# Name contract for Infisical staging:/backend. Do not create a runtime env file.
TALENT_SIGNAL_API_BASE_URL=https://your-mac.your-tailnet.ts.net

# Relationship Ask belongs in Infisical staging:/shared. Only the user's
# question and the minimum reviewed, published relationship context are sent.
# Keep this false until staging has its own Zhipu key; never reuse a dev key.
TALENT_SIGNAL_ALLOW_REMOTE_CHAT_PROCESSING=false
TALENT_SIGNAL_CHAT_PROVIDER=zhipu
TALENT_SIGNAL_CHAT_MODEL=glm-5.3
# Leave empty unless the environment has separately admitted private image
# processing with TALENT_SIGNAL_ALLOW_SENSITIVE_AI_PROCESSING=true.
TALENT_SIGNAL_CHAT_VISION_MODEL=
TALENT_SIGNAL_CHAT_TIMEOUT_MS=15000
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=replace-with-a-dedicated-staging-key-in-infisical

# Screenshot public-profile research uses the same admitted vision provider,
# but a separate Agent definition and a separate Agent Host credential domain.
# Keep the product gate false until both provider readbacks and the synthetic
# end-to-end probe pass.
TALENT_SIGNAL_AGENT_PROVIDER=zhipu
TALENT_SIGNAL_AGENT_VISION_MODEL=glm-4.6v-flash
TALENT_SIGNAL_PERSON_RESEARCH_ENABLED=false
TALENT_SIGNAL_PERSON_RESEARCH_TIMEOUT_MS=65000

# These two names belong only in Infisical staging:/agent-host.
TIKHUB_API_KEY=replace-with-a-dedicated-staging-key-in-infisical
TIKHUB_BASE_URL=https://api.tikhub.dev

# Recruiter dictation belongs in Infisical staging:/shared. The App ID and
# Access Token remain server-only. This voice-specific gate does not admit
# screenshots or candidate evidence to other remote model paths.
TALENT_SIGNAL_ALLOW_SENSITIVE_AI_PROCESSING=false
TALENT_SIGNAL_ALLOW_REMOTE_VOICE_TRANSCRIPTION=true
VOICE_ASR_PROVIDER=doubao
DOUBAO_ASR_BASE_URL=https://openspeech.bytedance.com
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
DOUBAO_ASR_APP_ID=replace-in-infisical
DOUBAO_ASR_ACCESS_TOKEN=replace-in-infisical

# PostgreSQL is reachable only from the Compose network.
POSTGRES_DB=talent_signal_testflight
POSTGRES_USER=talent_signal_testflight
# Use a URL-safe generated value, for example: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-generated-hex-value

# Release authentication policy. Compose always disables simulated login.
APPLE_SIGN_IN_AUDIENCES=com.talentsignal.app
ALLOWED_ORIGINS=https://your-mac.your-tailnet.ts.net
SESSION_TTL_SECONDS=28800
RETENTION_SWEEP_INTERVAL_MS=60000
LOG_LEVEL=info

# The API is published on Mac loopback only; Tailscale terminates HTTPS.
BACKEND_PORT=4317
BACKEND_IMAGE=talent-signal-backend-local:testflight
TS_PNPM_REGISTRY=https://registry.npmjs.org

# Runtime DNS defaults keep Apple public-key verification working when
# Tailscale owns the Mac's scoped DNS configuration. Override only if required.
TS_TESTFLIGHT_DNS_PRIMARY=100.100.100.100
TS_TESTFLIGHT_DNS_FALLBACK=114.114.114.114
